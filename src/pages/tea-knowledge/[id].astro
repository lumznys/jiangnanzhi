---
import SiteLayout from '../../layouts/SiteLayout.astro';
import content from '../../data/content.json';
export function getStaticPaths(){return content.tea.map(article=>({params:{id:String(article.id)},props:{article}}));}
const {article}=Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://www.jiangnantea.com').href;
const schema={'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.excerpt,datePublished:article.date,author:{'@id':'https://www.jiangnantea.com/#organization'},publisher:{'@id':'https://www.jiangnantea.com/#organization'},mainEntityOfPage:canonical};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://www.jiangnantea.com/' },
    { '@type': 'ListItem', position: 2, name: '茶叶科普', item: 'https://www.jiangnantea.com/tea-knowledge/' },
    { '@type': 'ListItem', position: 3, name: article.title, item: canonical },
  ],
};
---
<SiteLayout title={`${article.title} — 江南枝`} description={article.excerpt} schema={schema}>
  <article class="pt-32 pb-20 bg-background">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <a href="/tea-knowledge" class="inline-flex items-center gap-2 text-muted-foreground hover:text-primary transition-colors duration-300 mb-8">← 返回茶叶科普</a>
      <div class="flex items-center gap-3 mb-4"><span class="inline-flex items-center gap-1 px-2.5 py-0.5 text-xs rounded-full bg-primary/10 text-primary">{article.category}</span><time class="text-sm text-muted-foreground" datetime={article.date}>{article.date}</time></div>
      <h1 class="font-serif text-3xl lg:text-4xl font-bold text-foreground mb-6 leading-tight">{article.title}</h1>
      <img src={article.image} alt={article.title} class="w-full h-[300px] lg:h-[400px] object-cover rounded-lg mb-10" />
      <div class="prose prose-lg max-w-none">{article.content.split('\n\n').map(paragraph=><p class="text-foreground/90 leading-relaxed mb-6 text-base lg:text-lg">{paragraph}</p>)}</div>
      <div class="mt-16 pt-8 border-t border-border/50"><h3 class="font-serif text-xl font-bold text-foreground mb-4">想了解更多茶叶知识？</h3><p class="text-muted-foreground mb-6">关注「江南枝茶业」公众号，获取更多茶叶科普文章和品牌动态。</p><div class="flex flex-wrap gap-4"><a href="/tea-knowledge" class="inline-flex items-center gap-2 px-5 py-2.5 bg-secondary text-secondary-foreground rounded-md hover:bg-secondary/80 transition-colors duration-300">← 返回文章列表</a><a href="/contact" class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors duration-300">联系我们 →</a></div></div>
    </div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema).replace(/</g, '\u003c')} />
</SiteLayout>
