---
import { getCollection } from 'astro:content';
import { render } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('knowledge');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
// 题图提取：优先取 markdown 正文中的第一张图（文章首图），无正文图时回退到 frontmatter 的 image
const firstImageRe = /!\[[^\]]*\]\(\s*<?([^)\s>]+)>?/;
const bodyImgMatch = entry.body?.match(firstImageRe);
const heroImage = bodyImgMatch?.[1] ?? entry.data.image;
// 正文渲染时移除首图，避免与题图重复显示
const renderBody = bodyImgMatch ? entry.body!.replace(bodyImgMatch[0], '') : entry.body;
const { Content } = await render({ ...entry, body: renderBody });
const canonical = new URL(Astro.url.pathname, 'https://www.jiangnantea.com').href;
const dateStr = entry.data.date.toISOString().slice(0, 10);
const organization = { '@id': 'https://www.jiangnantea.com/#organization' };
const schema = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: entry.data.title, description: entry.data.excerpt,
  image: heroImage ? `https://www.jiangnantea.com${heroImage}` : undefined,
  datePublished: dateStr, author: organization, publisher: organization, mainEntityOfPage: canonical,
};
const breadcrumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: '首页', item: 'https://www.jiangnantea.com/' },
  { '@type': 'ListItem', position: 2, name: '茶叶科普', item: 'https://www.jiangnantea.com/tea-knowledge/' },
  { '@type': 'ListItem', position: 3, name: entry.data.title, item: canonical },
] };
---
<SiteLayout title={`${entry.data.title} — 江南枝`} description={entry.data.excerpt} schema={schema}>
  <article class="pt-32 pb-20 bg-background"><div class="max-w-4xl mx-auto px-6 lg:px-8">
    <a href="/tea-knowledge" class="inline-flex items-center gap-2 text-muted-foreground hover:text-primary transition-colors duration-300 mb-8">← 返回茶叶科普</a>
    <div class="flex items-center gap-3 mb-4"><span class="inline-flex items-center gap-1 px-2.5 py-0.5 text-xs rounded-full bg-primary/10 text-primary">{entry.data.category}</span>
      <time class="text-sm text-muted-foreground" datetime={dateStr}>{dateStr}</time>
    </div>
    <h1 class="font-serif text-3xl lg:text-4xl font-bold text-foreground mb-8 leading-tight">{entry.data.title}</h1>
    {heroImage && <img src={heroImage} alt={entry.data.title} class="w-full h-[300px] lg:h-[400px] object-cover object-top rounded-lg mb-10" loading="lazy" />}
    <div class="markdown-content"><Content /></div>
    <div class="mt-16 pt-8 border-t border-border/50"><div class="flex flex-wrap gap-4">
      <a href="/tea-knowledge" class="inline-flex items-center gap-2 px-5 py-2.5 bg-secondary text-secondary-foreground rounded-md">← 返回文章列表</a>
      <a href="/contact" class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-primary-foreground rounded-md">联系我们 →</a>
    </div></div>
  </div></article>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs).replace(/</g, '\u003c')} />
</SiteLayout>
<style>
  /* 正文首图与题图为同一张：隐藏正文开头的第一张图避免重复显示 */
  .markdown-content :global(> p:first-child > img:only-child),
  .markdown-content :global(> img:first-child){display:none}
  .markdown-content{font-size:1rem;line-height:1.8;overflow-wrap:anywhere}
  .markdown-content :global(p),.markdown-content :global(ul),.markdown-content :global(ol){margin-bottom:1.5rem}
  .markdown-content :global(h2){font-size:1.5rem;font-weight:700;margin:3rem 0 1.5rem}
  .markdown-content :global(h3){font-size:1.25rem;font-weight:600;margin:2rem 0 1rem}
  .markdown-content :global(ul){list-style:disc;padding-left:1.5rem}
  .markdown-content :global(ol){list-style:decimal;padding-left:1.5rem}
  .markdown-content :global(li){margin:.4rem 0}
  .markdown-content :global(a){color:hsl(var(--primary));text-decoration:underline}
  .markdown-content :global(blockquote){border-left:3px solid hsl(var(--primary));padding-left:1rem}
  .markdown-content :global(img){max-width:100%;height:auto}
  .markdown-content :global(pre){overflow-x:auto;padding:1rem;background:hsl(var(--secondary))}
  @media(min-width:1024px){.markdown-content{font-size:1.125rem}.markdown-content :global(h2){font-size:1.875rem}}
</style>
