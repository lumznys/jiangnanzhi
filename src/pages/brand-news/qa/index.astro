---
import { getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import CollectionCards from '../../../components/CollectionCards.astro';
const entries=(await getCollection('qa')).sort((a,b)=>{
  const da=a.data.date?.getTime()??-1, db=b.data.date?.getTime()??-1;
  return db-da || ((a.data.order??9999)-(b.data.order??9999)) || a.id.localeCompare(b.id);
});
const schema={
  '@context':'https://schema.org',
  '@type':'FAQPage',
  mainEntity:entries.map(entry=>({
    '@type':'Question',name:entry.data.title,
    acceptedAnswer:{'@type':'Answer',text:entry.data.description},
  })),
};
const breadcrumbs={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
  {'@type':'ListItem',position:1,name:'首页',item:'https://www.jiangnantea.com/'},
  {'@type':'ListItem',position:2,name:'品牌资讯',item:'https://www.jiangnantea.com/brand-news/'},
  {'@type':'ListItem',position:3,name:'常见问题',item:'https://www.jiangnantea.com/brand-news/qa/'},
]};
---
<SiteLayout title="常见问题 - 江南枝" description="江南枝常见问题解答，介绍茶叶来源、保存方法、绿茶冲泡方式、价格说明，以及为什么创立江南枝，帮助您了解品牌与日常饮茶。" schema={schema}>
  <section class="pt-32 pb-16 bg-secondary text-center"><div class="max-w-3xl mx-auto px-6">
    <a href="/brand-news/" class="inline-flex items-center gap-2 text-primary mb-6">← 返回品牌资讯</a>
    <h1 class="font-serif text-4xl lg:text-5xl font-bold text-foreground mb-4">常见问题 - 江南枝</h1>
    <p class="text-muted-foreground text-lg">茶叶来源、保存与冲泡方法、价格说明及品牌理念</p>
  </div></section>
  <section class="py-16 bg-background"><div class="max-w-4xl mx-auto px-6 lg:px-8"><CollectionCards entries={entries} section="qa" /></div></section>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs).replace(/</g,'\u003c')} />
</SiteLayout>
