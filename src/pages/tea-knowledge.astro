---
import { getCollection } from 'astro:content';
import { render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

// 全部文章按日期从近到远；页面仅展示最近 8 篇，其余文章仍生成详情页并通过 ItemList 供 AI/爬虫抓取
const all = (await getCollection('knowledge')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const entries = all.slice(0, 8);

// 题图提取：优先取 markdown 正文中的第一张图（文章首图），无正文图时回退到 frontmatter 的 image
const firstImageRe = /!\[[^\]]*\]\(\s*<?([^)\s>]+)>?/;
const imgOf = (entry: (typeof all)[number]) =>
  entry.body?.match(firstImageRe)?.[1] ?? entry.data.image;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: 'https://www.jiangnantea.com/' },
        { '@type': 'ListItem', position: 2, name: '茶叶科普', item: 'https://www.jiangnantea.com/tea-knowledge/' },
      ],
    },
    // ItemList 覆盖全部文章（含未在页面上展示的），供 AI 引擎与爬虫抓取完整清单
    {
      '@type': 'ItemList',
      name: '茶叶科普文章列表',
      numberOfItems: all.length,
      itemListElement: all.map((e, i) => ({
        '@type': 'ListItem', position: i + 1, name: e.data.title,
        url: `https://www.jiangnantea.com/tea-knowledge/knowledge-article/${e.id}/`,
      })),
    },
  ],
};
---
<SiteLayout title="茶叶科普 - 江南枝" description="江南枝精选茶叶科普文章，涵盖岩茶知识、选茶指南、冲泡技巧与存茶方法，助您轻松入门茶文化。" schema={breadcrumb}>
<section class="pt-32 pb-16 bg-secondary text-center">
<div class="max-w-3xl mx-auto px-6">
<h1 class="font-serif text-4xl lg:text-5xl font-bold text-foreground mb-4">茶叶科普</h1>
<p class="text-muted-foreground text-lg">来自「江南枝茶业」公众号的精选文章，涵盖岩茶知识、选茶指南、冲泡技巧与存茶方法，与您分享茶的知识与乐趣</p>
</div>
</section>
<section id="knowledge-lists" class="py-20 lg:py-28 bg-background">
<div class="max-w-5xl mx-auto px-6 lg:px-8">
<div class="space-y-12">
{entries.map((entry, i) => {
  const dateStr = entry.data.date.toISOString().slice(0, 10);
  const href = `/tea-knowledge/knowledge-article/${entry.id}/`;
  return (
  <div data-reveal="" data-delay={i * 100}>
  <article class="flex flex-col md:flex-row gap-6 lg:gap-8 pb-12 border-b border-border/50 last:border-0">
  <div class="md:w-2/5 shrink-0">
  <img src={imgOf(entry)} alt={entry.data.title} class="w-full h-[220px] md:h-[200px] object-cover object-top rounded-lg" loading="lazy">
  </div>
  <div class="md:w-3/5 flex flex-col">
  <div class="flex items-center gap-3 mb-3">
  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 text-xs rounded-full bg-primary/10 text-primary">{entry.data.category}</span>
  <time class="text-sm text-muted-foreground" datetime={dateStr}>{dateStr}</time>
  </div>
  <h2 class="font-serif text-xl lg:text-2xl font-bold text-foreground mb-3 leading-snug">{entry.data.title}</h2>
  <p class="text-muted-foreground text-sm leading-relaxed mb-4 flex-grow">{entry.data.excerpt}</p>
  <a class="knowledge-open inline-flex items-center gap-2 text-primary text-sm font-medium hover:gap-3 transition-all duration-300 self-start" href={href} data-slug={entry.id}>阅读全文 <svg viewBox="0 0 448 512" size="12" fill="currentColor" stroke="currentColor" stroke-width="0" width="12" height="12" aria-hidden="true">
  <path d="M190.5 66.9l22.2-22.2c9.4-9.4 24.6-9.4 33.9 0L441 239c9.4 9.4 9.4 24.6 0 33.9L246.6 467.3c-9.4 9.4-24.6 9.4-33.9 0l-22.2-22.2c-9.5-9.5-9.3-25 .4-34.3L311.4 296H24c-13.3 0-24-10.7-24-24v-32c0-13.3 10.7-24 24-24h287.4L190.9 101.2c-9.8-9.3-10-24.8-.4-34.3z">
  </path>
  </svg>
  </a>
  </div>
  </article>
  </div>
  );
})}
</div>
</div>
</section>
<div id="knowledge-article" class="py-16 bg-background" hidden>
  <div class="max-w-3xl mx-auto px-6 lg:px-8">
    <button id="knowledge-back" type="button" class="inline-flex items-center gap-2 text-muted-foreground hover:text-primary transition-colors duration-300 mb-8 cursor-pointer">← 返回茶叶科普</button>
    <div class="flex items-center gap-3 mb-4">
      <span id="knowledge-label" class="inline-flex items-center gap-1 px-2.5 py-0.5 text-xs rounded-full bg-primary/10 text-primary"></span>
      <time id="knowledge-time" class="text-sm text-muted-foreground" hidden></time>
    </div>
    <div id="knowledge-title" class="font-serif text-3xl lg:text-4xl font-bold text-foreground mb-6 leading-tight"></div>
    <img id="knowledge-image" src="" alt="" class="w-full h-[300px] lg:h-[400px] object-cover rounded-lg mb-10" hidden />
    <div id="knowledge-body" class="article-view"></div>
    <div class="mt-16 pt-8 border-t border-border/50">
      <button id="knowledge-back-2" type="button" class="inline-flex items-center gap-2 px-5 py-2.5 bg-secondary text-secondary-foreground rounded-md hover:bg-secondary/80 transition-colors duration-300 cursor-pointer">← 返回文章列表</button>
    </div>
  </div>
</div>

{/* 构建时注入全部文章的正文模板：页内阅读零请求、点击必定生效；模板对爬虫同样可读 */}
<script type="application/json" id="knowledge-meta" set:html={JSON.stringify(Object.fromEntries(all.map((e) => [e.id, { title: e.data.title, category: e.data.category, date: e.data.date.toISOString().slice(0, 10), image: imgOf(e) }]))).replace(/</g, '\u003c')} />
{await Promise.all(all.map(async (entry) => {
  const { Content } = await render(entry);
  return (
  <template id={`ka-tpl-${entry.id}`}>
    <Content />
  </template>
  );
}))}
</SiteLayout>

{/* 正文排版样式已移至全局 site.css 的 .article-view 规则（JS 注入内容不受 scoped 样式作用） */}

<script>
  // 页内阅读：正文在构建时已注入 <template>，点击直接展示（零网络请求，茶叶科普标题容器保持不动）
  const lists = document.getElementById('knowledge-lists')!;
  const viewer = document.getElementById('knowledge-article')!;
  const labelEl = document.getElementById('knowledge-label')!;
  const timeEl = document.getElementById('knowledge-time') as HTMLTimeElement;
  const titleEl = document.getElementById('knowledge-title')!;
  const imageEl = document.getElementById('knowledge-image') as HTMLImageElement;
  const bodyEl = document.getElementById('knowledge-body')!;

  const articleMeta: Record<string, { title: string; category: string; date: string; image: string }> = JSON.parse(
    (document.getElementById('knowledge-meta') as HTMLScriptElement | null)?.textContent ?? '{}'
  );

  function openArticle(slug: string, push = true) {
    const tpl = document.getElementById(`ka-tpl-${slug}`) as HTMLTemplateElement | null;
    if (!tpl) { location.href = `/tea-knowledge/knowledge-article/${slug}/`; return; }
    const meta = articleMeta[slug];
    if (meta) {
      labelEl.textContent = meta.category;
      timeEl.textContent = meta.date;
      timeEl.setAttribute('datetime', meta.date);
      timeEl.hidden = false;
      titleEl.textContent = meta.title;
      if (meta.image) { imageEl.src = meta.image; imageEl.alt = meta.title; imageEl.hidden = false; }
      else imageEl.hidden = true;
    }
    bodyEl.innerHTML = '';
    bodyEl.appendChild(tpl.content.cloneNode(true));
    lists.hidden = true;
    viewer.hidden = false;
    if (push) history.pushState(null, '', `#knowledge-${slug}`);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function showLists(push = true) {
    viewer.hidden = true;
    lists.hidden = false;
    if (push) history.pushState(null, '', location.pathname);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  document.querySelectorAll<HTMLAnchorElement>('.knowledge-open').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      openArticle(a.dataset.slug!);
    });
  });
  document.getElementById('knowledge-back')!.addEventListener('click', () => showLists());
  document.getElementById('knowledge-back-2')!.addEventListener('click', () => showLists());

  window.addEventListener('popstate', () => {
    const m = location.hash.match(/^#knowledge-([\w-]+)$/);
    if (m) openArticle(m[1], false);
    else showLists(false);
  });

  // 支持 #knowledge-<slug> 直达链接
  const initial = location.hash.match(/^#knowledge-([\w-]+)$/);
  if (initial) openArticle(initial[1], false);
</script>
