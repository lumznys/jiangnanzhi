---
import SiteLayout from '../layouts/SiteLayout.astro';
import * as story from '../content/brand-story.md';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://www.jiangnantea.com/' },
    { '@type': 'ListItem', position: 2, name: '关于江南枝', item: 'https://www.jiangnantea.com/about/' },
  ],
};
---
<SiteLayout title="关于我们 - 江南枝" description="了解江南枝品牌故事与制茶理念，探寻江南乌龙茶核心产区的匠心传承，守一枝茶香，归一味本真。" schema={breadcrumb}>
<section class="pt-32 pb-16 bg-secondary text-center">
<div class="max-w-3xl mx-auto px-6">
<h1 class="font-serif text-4xl lg:text-5xl font-bold text-foreground mb-4">关于江南枝</h1>
<p class="text-muted-foreground text-lg tracking-[0.2em]">一枝凝漳韵，一城逢知己</p>
</div>
</section>
<section class="py-20 lg:py-28 bg-background">
<div class="max-w-4xl mx-auto px-6 lg:px-8">
<div class="" data-reveal="" data-delay="0">
<h2 class="font-serif text-3xl font-bold text-foreground mb-8 text-center">品牌故事</h2>
<div class="prose prose-lg max-w-none text-muted-foreground leading-relaxed space-y-6">
<story.Content />
</div>
</div>
</div>
</section>
<section class="py-20 lg:py-28 bg-secondary">
<div class="max-w-5xl mx-auto px-6 lg:px-8">
<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
<div class="" data-reveal="" data-delay="0">
<img src="/images/tea-farmer-picking-fresh-tea-leaves-on-terraced-hill-291758c9.jpg" alt="茶农采茶" class="w-full h-[350px] object-cover rounded-lg" loading="lazy">
</div>
<div class="" data-reveal="" data-delay="200">
<h2 class="font-serif text-3xl font-bold text-foreground mb-6">制茶理念</h2>
<div class="space-y-4 text-muted-foreground leading-relaxed">
<p>我们坚信，好茶源于对自然的敬畏与对品质的执着。江南枝的选茶标准简单而严格： 优质原茶，匠心工艺、良心筛选、严格检测。</p>
<p>我们与各初制工厂建立长期合作关系，尊重每一片茶叶的生长节奏， 不催熟、不添加，让茶保持最本真的滋味。从采摘到制作， 每一步都经过专业审评师的严格把控，每一批都经专业检测机构严格检测。</p>
</div>
</div>
</div>
</div>
</section>
<section class="py-20 lg:py-28 bg-background">
<div class="max-w-5xl mx-auto px-6 lg:px-8">
<div class="" data-reveal="" data-delay="0">
<h2 class="font-serif text-3xl font-bold text-foreground mb-8 text-center">产地溯源</h2>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
<div class="" data-reveal="" data-delay="0">
<div class="relative rounded-lg overflow-hidden h-64">
<img src="/images/west-lake-hangzhou-tea-garden-spring-mist-7a3785cc.jpg" alt="西湖茶园" class="w-full h-full object-cover" loading="lazy">
<div class="absolute inset-0 bg-gradient-to-t from-primary/70 to-transparent flex items-end p-6">
<h3 class="font-serif text-xl font-semibold text-primary-foreground">福建·武夷山</h3>
</div>
</div>
</div>
<div class="" data-reveal="" data-delay="150">
<div class="relative rounded-lg overflow-hidden h-64">
<img src="/images/fuding-fujian-white-tea-plantation-mountain-mist-e2b50db6.jpg" alt="福鼎茶园" class="w-full h-full object-cover" loading="lazy">
<div class="absolute inset-0 bg-gradient-to-t from-primary/70 to-transparent flex items-end p-6">
<h3 class="font-serif text-xl font-semibold text-primary-foreground">福建·平和</h3>
</div>
</div>
</div>
</div>
</div>
</section>
</SiteLayout>
