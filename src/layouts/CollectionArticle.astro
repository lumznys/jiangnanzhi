---
import { render, type CollectionEntry } from 'astro:content';
import SiteLayout from './SiteLayout.astro';
interface Props { entry: CollectionEntry<'qa'> | CollectionEntry<'news'>; legacy?: boolean; }
const {entry,legacy=false}=Astro.props;
const {Content}=await render(entry);
const news=entry.collection==='news';
const label=news?'企业动态':'常见问题';
const section=news?'news':'qa';
const canonical=new URL(Astro.url.pathname,'https://www.jiangnantea.com').href;
const canonicalOverride=legacy?'https://www.jiangnantea.com/brand-news/news/2026-spring-tea-expo/':undefined;
const organization={'@id':'https://www.jiangnantea.com/#organization'};
const description=legacy?`原问答栏目企业动态：${entry.data.description}`:entry.data.description;
const schema={
  '@context':'https://schema.org','@type':news?'NewsArticle':'Article',
  headline:entry.data.title,description,datePublished:entry.data.date?.toISOString(),
  author:organization,publisher:organization,mainEntityOfPage:canonicalOverride??canonical,
};
const breadcrumbs={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
  {'@type':'ListItem',position:1,name:'首页',item:'https://www.jiangnantea.com/'},
  {'@type':'ListItem',position:2,name:'品牌资讯',item:'https://www.jiangnantea.com/brand-news/'},
  {'@type':'ListItem',position:3,name:label,item:`https://www.jiangnantea.com/brand-news/${section}/`},
  {'@type':'ListItem',position:4,name:entry.data.title,item:canonical},
]};
const title=legacy?`${entry.data.title}（原栏目存档） — 江南枝`:`${entry.data.title} — 江南枝`;
---
<SiteLayout title={title} description={description} schema={schema} noindex={legacy} canonicalOverride={canonicalOverride}>
  <article class="pt-32 pb-20 bg-background"><div class="max-w-4xl mx-auto px-6 lg:px-8">
    <a href={`/brand-news/${section}/`} class="inline-flex items-center gap-2 text-muted-foreground hover:text-primary transition-colors duration-300 mb-8">← 返回{label}</a>
    <div class="flex items-center gap-3 mb-4"><span class="inline-flex items-center gap-1 px-2.5 py-0.5 text-xs rounded-full bg-primary/10 text-primary">{label}</span>
      {entry.data.date && <time class="text-sm text-muted-foreground" datetime={entry.data.date.toISOString().slice(0,10)}>{entry.data.date.toISOString().slice(0,10)}</time>}
    </div>
    <h1 class="font-serif text-3xl lg:text-4xl font-bold text-foreground mb-10 leading-tight">{entry.data.title}</h1>
    {legacy && <p class="text-muted-foreground mb-6">本文已归入企业动态，<a class="text-primary underline" href={`/brand-news/news/${entry.id}/`}>查看企业动态中的文章</a>。</p>}
    <div class="markdown-content"><Content /></div>
    <div class="mt-16 pt-8 border-t border-border/50"><div class="flex flex-wrap gap-4">
      <a href={`/brand-news/${section}/`} class="inline-flex items-center gap-2 px-5 py-2.5 bg-secondary text-secondary-foreground rounded-md">← 返回{label}列表</a>
      <a href="/contact" class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-primary-foreground rounded-md">联系我们 →</a>
    </div></div>
  </div></article>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs).replace(/</g,'\u003c')} />
</SiteLayout>
<style>
  .markdown-content{font-size:1rem;line-height:1.8;overflow-wrap:anywhere}
  .markdown-content :global(p),.markdown-content :global(ul),.markdown-content :global(ol){margin-bottom:1.5rem}
  .markdown-content :global(h2){font-size:1.5rem;font-weight:700;margin:3rem 0 1.5rem}
  .markdown-content :global(h3){font-size:1.25rem;font-weight:600;margin:2rem 0 1rem}
  .markdown-content :global(ul){list-style:disc;padding-left:1.5rem}
  .markdown-content :global(ol){list-style:decimal;padding-left:1.5rem}
  .markdown-content :global(li){margin:.4rem 0}
  .markdown-content :global(a){color:hsl(var(--primary));text-decoration:underline}
  .markdown-content :global(blockquote){border-left:3px solid hsl(var(--primary));padding-left:1rem}
  .markdown-content :global(img){max-width:100%;height:auto}
  .markdown-content :global(pre){overflow-x:auto;padding:1rem;background:hsl(var(--secondary))}
  @media(min-width:1024px){.markdown-content{font-size:1.125rem}.markdown-content :global(h2){font-size:1.875rem}}
</style>
