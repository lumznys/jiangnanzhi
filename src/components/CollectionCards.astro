---
import type { CollectionEntry } from 'astro:content';
interface Props { entries: (CollectionEntry<'qa'> | CollectionEntry<'news'>)[]; section: 'qa' | 'news'; headingLevel?: 'h2' | 'h3'; }
const {entries, section, headingLevel='h2'}=Astro.props;
const Heading=headingLevel;
const dateLabel=(date:Date)=>`${date.getUTCFullYear()}年${date.getUTCMonth()+1}月${date.getUTCDate()}日`;
---
<div class="space-y-4">
  {entries.map(entry => <article class="bg-secondary rounded-lg overflow-hidden" data-entry-id={entry.id}>
    <a href={`/brand-news/${section}/${entry.id}/`} class="block p-6 hover:bg-secondary/80 transition-colors duration-300">
      <div class="flex items-center gap-3 mb-3">
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 text-xs rounded-full bg-primary/10 text-primary">{section==='qa'?'常见问题':'企业动态'}</span>
        {entry.data.date && <time class="text-sm text-muted-foreground" datetime={entry.data.date.toISOString().slice(0,10)}>{dateLabel(entry.data.date)}</time>}
      </div>
      <Heading class="font-serif text-lg lg:text-xl font-semibold text-foreground mb-2">{entry.data.title}</Heading>
      <p class="text-muted-foreground text-sm leading-relaxed">{entry.data.description}</p>
      <span class="inline-flex items-center gap-1 mt-3 text-primary text-sm font-medium">阅读全文 →</span>
    </a>
  </article>)}
</div>
